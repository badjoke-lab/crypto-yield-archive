{
  "name": "crypto-yield-archive",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-based historical registry of crypto lending, Earn, and yield platforms.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-build-metadata.mjs && astro dev",
    "prebuild": "node scripts/generate-build-metadata.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate-data.mjs && node scripts/validate-batch-13.mjs && node scripts/candidates.mjs",
    "quality": "node scripts/data-quality-report.mjs && node scripts/data-quality-report-batch-13.mjs",
    "audit": "node scripts/audit-corpus.mjs && node scripts/lifecycle-gap-report.mjs",
    "lifecycle:report": "node scripts/lifecycle-gap-report.mjs",
    "test:lifecycle-gap": "node scripts/test-lifecycle-gap-report.mjs",
    "candidates:check": "node scripts/candidates.mjs",
    "candidates:scan": "node scripts/candidate-scanner.mjs",
    "candidates:scan:guard": "node scripts/check-candidate-scan.mjs",
    "candidates:draft": "node scripts/candidate-draft-generator.mjs",
    "test:candidate-scanner": "node scripts/test-candidate-scanner.mjs && node scripts/test-candidate-scan-guard.mjs",
    "test:candidate-drafts": "node scripts/test-candidate-draft-generator.mjs",
    "monitor:records": "node scripts/existing-record-monitor.mjs",
    "monitor:records:network": "node scripts/existing-record-monitor.mjs --network",
    "test:monitor": "node scripts/test-existing-record-monitor.mjs",
    "batch:next-ids": "node scripts/next-batch-ids.mjs",
    "check:build-output": "node scripts/check-build-output.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test": "npm run validate && npm run quality && npm run audit && npm run test:lifecycle-gap && npm run test:candidate-scanner && npm run test:candidate-drafts && npm run test:monitor && npm run build && npm run check:build-output"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {}
}
