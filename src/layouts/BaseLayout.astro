---
import '../styles/global.css';

const {
  title = 'Crypto Yield Archive',
  description = 'Evidence-based historical registry of crypto lending, Earn, and yield platforms.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://cya.badjoke-lab.com').toString();
const siteName = 'Crypto Yield Archive';
const correctionUrl = '/corrections/';
const repoUrl = 'https://github.com/badjoke-lab/crypto-yield-archive';
const gaMeasurementId = 'G-LWCGTDBY6W';
const gaTagUrl = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script async src={gaTagUrl}></script>
    <script define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId);
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Crypto Yield Archive home">
          <span class="brand-mark">CYA</span>
          <span>
            <strong>Crypto Yield Archive</strong>
            <small>Historical yield registry</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/outcomes/">Outcomes</a>
          <a href="/failures/">Failures</a>
          <a href="/terms-risk/">Terms risk</a>
          <a href="/timeline/">Timeline</a>
          <a href="/stats/">Stats</a>
          <a href="/source-quality/">Source quality</a>
          <a href="/methodology/">Methodology</a>
          <a href="/about/">About</a>
          <a class="utility-link" href={correctionUrl}>Submit correction</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>Crypto Yield Archive is a historical registry, not an investment recommendation, APY ranking, or real-time dashboard.</p>
        <div class="footer-links">
          <a href={correctionUrl}>Submit correction</a>
          <a href={repoUrl}>GitHub</a>
          <a href="/methodology/">Methodology</a>
          <a href="/source-quality/">Source quality</a>
        </div>
      </footer>
    </div>
  </body>
</html>
