---
import '../styles/global.css';

const {
  title = 'Crypto Yield Archive',
  description = 'Evidence-based historical registry of crypto lending, Earn, and yield platforms.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://cya.badjoke-lab.com').toString();
const siteName = 'Crypto Yield Archive';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Crypto Yield Archive home">
          <span class="brand-mark">CYA</span>
          <span>
            <strong>Crypto Yield Archive</strong>
            <small>Historical yield registry</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/outcomes/">Outcomes</a>
          <a href="/bankruptcy-cases/">Bankruptcy</a>
          <a href="/source-quality/">Source quality</a>
          <a href="/methodology/">Methodology</a>
          <a href="/about/">About</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>Crypto Yield Archive is a historical registry, not an investment recommendation, APY ranking, or real-time dashboard.</p>
      </footer>
    </div>
  </body>
</html>
