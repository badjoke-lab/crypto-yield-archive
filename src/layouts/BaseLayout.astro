---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/platform.css';
import '../styles/registries.css';
import '../styles/qa.css';
import '../styles/ui-improvements.css';
import { PROJECT, PUBLIC_DATA_ROUTES, getBuildMetadata, getDerivedCounts, getRecordCounts, getRecordsLastReviewedAt } from '../lib/machine-readable';
import { projectNetwork } from '../lib/project-network';

interface Props {
  title?: string;
  description?: string;
}

const counts = getRecordCounts();
const derived = getDerivedCounts();
const build = getBuildMetadata();
const defaultDescription = `Evidence-based historical registry with ${counts.platforms} crypto lending and yield platforms, ${counts.events} events, and ${counts.evidence} evidence records.`;
const {
  title = PROJECT.siteName,
  description = defaultDescription,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site ?? new URL(PROJECT.canonicalOrigin);
const canonicalUrl = new URL(currentPath, siteOrigin).toString();
const socialImageUrl = new URL('/og/cya-og.svg', siteOrigin).toString();
const correctionUrl = '/corrections/';
const supportUrl = '/support/';
const repoUrl = 'https://github.com/badjoke-lab/crypto-yield-archive';
const gaMeasurementId = 'G-LWCGTDBY6W';
const gaTagUrl = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
const isPlatformPage = currentPath.startsWith('/platform/');
const isSupportPage = currentPath === supportUrl;
const primaryNavItems = [
  ['/platforms/', 'Registry'],
  ['/failures/', 'Failures'],
];
const secondaryNavItems = [
  ['/compare/', 'Compare'],
  ['/outcomes/', 'Outcomes'],
  ['/terms-risk/', 'Terms risk'],
  ['/timeline/', 'Timeline'],
  ['/stats/', 'Stats'],
  ['/source-quality/', 'Source quality'],
  ['/methodology/', 'Methodology'],
  ['/about/', 'About'],
];
const researchLinks = [
  ['/platforms/', 'Platforms'],
  ['/compare/', 'Compare'],
  ['/outcomes/', 'Outcomes'],
  ['/failures/', 'Failures'],
  ['/terms-risk/', 'Terms risk'],
  ['/timeline/', 'Timeline'],
  ['/stats/', 'Statistics'],
];
const projectLinks = [
  ['/methodology/', 'Methodology'],
  ['/source-quality/', 'Source quality'],
  ['/about/', 'About'],
  [correctionUrl, 'Submit correction'],
  [repoUrl, 'GitHub'],
];
const dataLinks = [
  ['/version.json', 'Version JSON'],
  ['/data/manifest.json', 'Data manifest'],
  ['/llms.txt', 'LLM guide'],
  ['/ai.txt', 'AI guide'],
];
const isCurrent = (href) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${PROJECT.canonicalOrigin}/#website`,
  name: PROJECT.siteName,
  url: `${PROJECT.canonicalOrigin}/`,
  description: defaultDescription,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'BadJoke-Lab', url: 'https://badjoke-lab.com/' },
};
const datasetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${PROJECT.canonicalOrigin}/#dataset`,
  name: PROJECT.siteName,
  description: defaultDescription,
  url: `${PROJECT.canonicalOrigin}/`,
  isAccessibleForFree: true,
  inLanguage: 'en',
  dateModified: getRecordsLastReviewedAt(),
  temporalCoverage: '2016/..',
  version: build.commit,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'BadJoke-Lab', url: 'https://badjoke-lab.com/' },
  measurementTechnique: 'Reviewed platform, event, evidence, outcome, product, and terms-risk records',
  variableMeasured: [
    `Platforms: ${counts.platforms}`,
    `Events: ${counts.events}`,
    `Evidence: ${counts.evidence}`,
    `Customer outcomes: ${counts.customer_outcomes}`,
    `Product profiles: ${counts.product_profiles}`,
    `Terms-risk records: ${counts.terms_risk_records}`,
    `Claims ongoing: ${derived.claims_ongoing}`,
  ],
  distribution: Object.entries(PUBLIC_DATA_ROUTES)
    .filter(([, route]) => route.endsWith('.json'))
    .map(([name, route]) => ({ '@type': 'DataDownload', name, encodingFormat: 'application/json', contentUrl: `${PROJECT.canonicalOrigin}${route}` })),
};
const platformName = String(title).replace(/\s*\|\s*Crypto Yield Archive\s*$/, '');
const breadcrumbJsonLd = isPlatformPage ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Registry', item: `${PROJECT.canonicalOrigin}/platforms/` },
    { '@type': 'ListItem', position: 2, name: platformName, item: canonicalUrl },
  ],
} : null;
const structuredData = [websiteJsonLd, ...(currentPath === '/' ? [datasetJsonLd] : []), ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3efe5" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    {Object.entries(PUBLIC_DATA_ROUTES).map(([name, route]) => (
      <link rel="alternate" type={route.endsWith('.json') ? 'application/json' : 'text/plain'} href={route} title={`CYA ${name.replace(/_/g, ' ')}`} />
    ))}
    <meta property="og:type" content={isPlatformPage ? 'article' : 'website'} />
    <meta property="og:site_name" content={PROJECT.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Crypto Yield Archive" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Crypto Yield Archive" />
    {structuredData.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
    <script async src={gaTagUrl}></script>
    <script define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <div class="masthead-row shell">
          <a class="brand" href="/" aria-label="Crypto Yield Archive home">
            <span class="brand-mark" aria-hidden="true">CYA</span>
            <span class="brand-copy"><strong>Crypto Yield Archive</strong><small>Historical lending and yield registry</small></span>
          </a>
          <div class="masthead-actions" aria-label="Archive actions">
            <span class="masthead-meta" aria-label="Archive description"><span>Evidence-led</span><span>Static registry</span></span>
            <a class="correction-action" href={correctionUrl}>Submit correction</a>
            {isSupportPage ? <span class="support-action current-action" aria-current="page">Support</span> : <a class="support-action" href={supportUrl}>Support</a>}
          </div>
        </div>
        <div class="nav-rule">
          <div class="navigation-shell shell">
            <nav class="site-nav primary-navigation" aria-label="Primary navigation">
              {primaryNavItems.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
            </nav>
            <details class="mobile-more-navigation" data-navigation-disclosure>
              <summary>Menu</summary>
              <nav aria-label="Additional navigation">
                {secondaryNavItems.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
                <a href={correctionUrl}>Submit correction</a>
              </nav>
            </details>
            <nav class="desktop-secondary-navigation" aria-label="Additional navigation">
              {secondaryNavItems.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
            </nav>
          </div>
        </div>
      </header>

      <main id="main-content" class="shell">
        <slot />
        {isPlatformPage && (
          <>
            <section class="record-support" aria-labelledby="record-support-title">
              <div><p class="kicker">Independent archive</p><h2 id="record-support-title">Help maintain customer-outcome records</h2><p>Support court-document review, source preservation, corrections, broken-link replacement, and long-term archive maintenance. Support does not influence classifications or evidence standards.</p></div>
              <a class="support-action" href={supportUrl}>Support CYA</a>
            </section>
            <section class="record-report" aria-labelledby="report-record-title"><div><p class="kicker">Record maintenance</p><h2 id="report-record-title">Report this record</h2><p>Report incorrect dates, status, customer outcome, terms-risk interpretation, URL history, or missing evidence.</p></div><a class="text-action" href={correctionUrl}>Submit correction →</a></section>
          </>
        )}
      </main>

      <footer class="site-footer">
        <div class="shell footer-groups">
          <section class="footer-summary"><strong>Crypto Yield Archive</strong><p>A reviewed historical registry of crypto lending, Earn products, failures, restructurings, repayments, and customer outcomes.</p></section>
          <section class="footer-group"><h2>Project network</h2><nav aria-label="Project network">
            {projectNetwork.map((project) => project.id === 'cya'
              ? <span class="footer-current-project" aria-current="page"><strong>{project.name}</strong><small>Current project</small></span>
              : <a href={project.href}><strong>{project.name}</strong><small>{project.description}</small></a>)}
          </nav></section>
          <section class="footer-group"><h2>Research</h2><nav aria-label="Research links">{researchLinks.map(([href, label]) => <a href={href}>{label}</a>)}</nav></section>
          <section class="footer-group"><h2>Project</h2><nav aria-label="Project links">{projectLinks.map(([href, label]) => <a href={href}>{label}</a>)}</nav></section>
          <section class="footer-group footer-support-group"><h2>Support & public data</h2><nav aria-label="Support and public data">
            {isSupportPage ? <span class="footer-current-link" aria-current="page">Support CYA</span> : <a class="footer-support-link" href={supportUrl}>Support CYA</a>}
            {dataLinks.map(([href, label]) => <a href={href}>{label}</a>)}
          </nav></section>
        </div>
        <div class="shell footer-legal"><p>Crypto Yield Archive is a historical registry, not an investment recommendation, APY ranking, or real-time dashboard.</p></div>
      </footer>
    </div>

    <script>
      document.querySelectorAll('[data-navigation-disclosure]').forEach((element) => {
        if (!(element instanceof HTMLDetailsElement)) return;
        const summary = element.querySelector('summary');
        const sync = () => summary?.setAttribute('aria-expanded', String(element.open));
        sync();
        element.addEventListener('toggle', sync);
        element.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !element.open) return;
          element.open = false;
          summary?.focus();
        });
      });

      const platformLayout = document.querySelector('.platform-layout');
      const platformMain = document.querySelector('.platform-main');
      if (platformLayout instanceof HTMLElement && platformMain instanceof HTMLElement) {
        const sections = [...platformMain.querySelectorAll(':scope > .record-section')];
        const toc = document.createElement('nav');
        toc.className = 'platform-page-toc';
        toc.setAttribute('aria-label', 'On this page');
        const titleElement = document.createElement('strong');
        titleElement.textContent = 'On this page';
        const list = document.createElement('ol');
        toc.append(titleElement, list);
        const collapsibleTitles = new Set(['Historical record', 'Evidence dossier', 'Related platforms']);

        sections.forEach((section, index) => {
          if (!(section instanceof HTMLElement)) return;
          const heading = section.querySelector('h2');
          if (!(heading instanceof HTMLElement)) return;
          const headingText = heading.textContent?.trim() || `Section ${index + 1}`;
          if (!heading.id) heading.id = `platform-section-${index + 1}`;
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.textContent = headingText;
          item.append(link);
          list.append(item);

          if (window.matchMedia('(max-width: 720px)').matches && collapsibleTitles.has(headingText)) {
            const head = section.querySelector('.record-section-head');
            const content = document.createElement('div');
            content.className = 'mobile-collapsible-content';
            [...section.children].filter((child) => child !== head).forEach((child) => content.append(child));
            content.hidden = true;
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'mobile-section-toggle';
            button.textContent = 'Show section';
            button.setAttribute('aria-expanded', 'false');
            button.addEventListener('click', () => {
              content.hidden = !content.hidden;
              button.setAttribute('aria-expanded', String(!content.hidden));
              button.textContent = content.hidden ? 'Show section' : 'Hide section';
            });
            head?.append(button);
            section.append(content);
          }
        });
        platformLayout.before(toc);
      }
    </script>
  </body>
</html>
