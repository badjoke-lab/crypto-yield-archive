---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/platform.css';
import '../styles/registries.css';
import '../styles/qa.css';
import { PROJECT, PUBLIC_DATA_ROUTES, getBuildMetadata, getDerivedCounts, getRecordCounts, getRecordsLastReviewedAt } from '../lib/machine-readable';

interface Props {
  title?: string;
  description?: string;
}

const counts = getRecordCounts();
const derived = getDerivedCounts();
const build = getBuildMetadata();
const defaultDescription = `Evidence-based historical registry with ${counts.platforms} crypto lending and yield platforms, ${counts.events} events, and ${counts.evidence} evidence records.`;
const {
  title = PROJECT.siteName,
  description = defaultDescription,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site ?? new URL(PROJECT.canonicalOrigin);
const canonicalUrl = new URL(currentPath, siteOrigin).toString();
const socialImageUrl = new URL('/og/cya-og.svg', siteOrigin).toString();
const correctionUrl = '/corrections/';
const repoUrl = 'https://github.com/badjoke-lab/crypto-yield-archive';
const gaMeasurementId = 'G-LWCGTDBY6W';
const gaTagUrl = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
const isPlatformPage = currentPath.startsWith('/platform/');
const navItems = [
  ['/', 'Registry'],
  ['/outcomes/', 'Outcomes'],
  ['/failures/', 'Failures'],
  ['/terms-risk/', 'Terms risk'],
  ['/timeline/', 'Timeline'],
  ['/stats/', 'Stats'],
  ['/source-quality/', 'Source quality'],
  ['/methodology/', 'Methodology'],
  ['/about/', 'About'],
];
const projectLinks = [
  ['https://badjoke-lab.com/', 'Hub'],
  ['https://hei.badjoke-lab.com/', 'HEI'],
  ['https://www.stableorgone.com/', 'SOG'],
  ['https://cya.badjoke-lab.com/', 'CYA'],
  ['https://bir.badjoke-lab.com/', 'BIR'],
];
const isCurrent = (href) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${PROJECT.canonicalOrigin}/#website`,
  name: PROJECT.siteName,
  url: `${PROJECT.canonicalOrigin}/`,
  description: defaultDescription,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'BadJoke-Lab', url: 'https://badjoke-lab.com/' },
};
const datasetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${PROJECT.canonicalOrigin}/#dataset`,
  name: PROJECT.siteName,
  description: defaultDescription,
  url: `${PROJECT.canonicalOrigin}/`,
  isAccessibleForFree: true,
  inLanguage: 'en',
  dateModified: getRecordsLastReviewedAt(),
  temporalCoverage: '2016/..',
  version: build.commit,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'BadJoke-Lab', url: 'https://badjoke-lab.com/' },
  measurementTechnique: 'Reviewed platform, event, evidence, outcome, product, and terms-risk records',
  variableMeasured: [
    `Platforms: ${counts.platforms}`,
    `Events: ${counts.events}`,
    `Evidence: ${counts.evidence}`,
    `Customer outcomes: ${counts.customer_outcomes}`,
    `Product profiles: ${counts.product_profiles}`,
    `Terms-risk records: ${counts.terms_risk_records}`,
    `Claims ongoing: ${derived.claims_ongoing}`,
  ],
  distribution: Object.entries(PUBLIC_DATA_ROUTES)
    .filter(([, route]) => route.endsWith('.json'))
    .map(([name, route]) => ({ '@type': 'DataDownload', name, encodingFormat: 'application/json', contentUrl: `${PROJECT.canonicalOrigin}${route}` })),
};
const platformName = String(title).replace(/\s*\|\s*Crypto Yield Archive\s*$/, '');
const breadcrumbJsonLd = isPlatformPage ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Registry', item: `${PROJECT.canonicalOrigin}/` },
    { '@type': 'ListItem', position: 2, name: platformName, item: canonicalUrl },
  ],
} : null;
const structuredData = [websiteJsonLd, ...(currentPath === '/' ? [datasetJsonLd] : []), ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3efe5" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    {Object.entries(PUBLIC_DATA_ROUTES).map(([name, route]) => (
      <link rel="alternate" type={route.endsWith('.json') ? 'application/json' : 'text/plain'} href={route} title={`CYA ${name.replace(/_/g, ' ')}`} />
    ))}
    <meta property="og:type" content={isPlatformPage ? 'article' : 'website'} />
    <meta property="og:site_name" content={PROJECT.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Crypto Yield Archive" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Crypto Yield Archive" />
    {structuredData.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
    <script async src={gaTagUrl}></script>
    <script define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <div class="masthead-row shell">
          <a class="brand" href="/" aria-label="Crypto Yield Archive home">
            <span class="brand-mark" aria-hidden="true">CYA</span>
            <span class="brand-copy"><strong>Crypto Yield Archive</strong><small>Historical lending and yield registry</small></span>
          </a>
          <div class="masthead-meta" aria-label="Archive description"><span>Evidence-led</span><span>Static registry</span><a href={correctionUrl}>Submit correction</a></div>
        </div>
        <div class="nav-rule"><nav class="site-nav shell" aria-label="Primary navigation">{navItems.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}</nav></div>
      </header>
      <main id="main-content" class="shell">
        <slot />
        {isPlatformPage && <section class="record-report" aria-labelledby="report-record-title"><div><p class="kicker">Record maintenance</p><h2 id="report-record-title">Report this record</h2><p>Report incorrect dates, status, customer outcome, terms-risk interpretation, URL history, or missing evidence.</p></div><a class="text-action" href={correctionUrl}>Submit correction →</a></section>}
      </main>
      <footer class="site-footer">
        <div class="shell footer-grid">
          <p>Crypto Yield Archive is a historical registry, not an investment recommendation, APY ranking, or real-time dashboard.</p>
          <div class="footer-links">
            {projectLinks.map(([href, label]) => <a href={href} aria-current={label === 'CYA' ? 'page' : undefined}>{label}</a>)}
            <a href={correctionUrl}>Submit correction</a>
            <a href={repoUrl}>GitHub</a>
            <a href="/methodology/">Methodology</a>
            <a href="/source-quality/">Source quality</a>
            <a href="/version.json">Version JSON</a>
            <a href="/data/manifest.json">Data manifest</a>
            <a href="/llms.txt">LLM guide</a>
            <a href="/ai.txt">AI entrypoint</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
