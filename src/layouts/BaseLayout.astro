---
import '../styles/global.css';
import '../styles/home.css';
import '../styles/platform.css';

const {
  title = 'Crypto Yield Archive',
  description = 'Evidence-based historical registry of crypto lending, Earn, and yield platforms.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://cya.badjoke-lab.com').toString();
const siteName = 'Crypto Yield Archive';
const correctionUrl = '/corrections/';
const repoUrl = 'https://github.com/badjoke-lab/crypto-yield-archive';
const gaMeasurementId = 'G-LWCGTDBY6W';
const gaTagUrl = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
const isPlatformPage = Astro.url.pathname.startsWith('/platform/');
const currentPath = Astro.url.pathname;
const navItems = [
  ['/', 'Registry'],
  ['/outcomes/', 'Outcomes'],
  ['/failures/', 'Failures'],
  ['/terms-risk/', 'Terms risk'],
  ['/timeline/', 'Timeline'],
  ['/stats/', 'Stats'],
  ['/source-quality/', 'Source quality'],
  ['/methodology/', 'Methodology'],
  ['/about/', 'About'],
];
const isCurrent = (href) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3efe5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script async src={gaTagUrl}></script>
    <script define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <div class="masthead-row shell">
          <a class="brand" href="/" aria-label="Crypto Yield Archive home">
            <span class="brand-mark" aria-hidden="true">CYA</span>
            <span class="brand-copy">
              <strong>Crypto Yield Archive</strong>
              <small>Historical lending and yield registry</small>
            </span>
          </a>
          <div class="masthead-meta" aria-label="Archive description">
            <span>Evidence-led</span>
            <span>Static registry</span>
            <a href={correctionUrl}>Submit correction</a>
          </div>
        </div>
        <div class="nav-rule">
          <nav class="site-nav shell" aria-label="Primary navigation">
            {navItems.map(([href, label]) => (
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
        </div>
      </header>

      <main id="main-content" class="shell">
        <slot />
        {isPlatformPage && (
          <section class="record-report" aria-labelledby="report-record-title">
            <div>
              <p class="kicker">Record maintenance</p>
              <h2 id="report-record-title">Report this record</h2>
              <p>Report incorrect dates, status, customer outcome, terms-risk interpretation, URL history, or missing evidence.</p>
            </div>
            <a class="text-action" href={correctionUrl}>Submit correction →</a>
          </section>
        )}
      </main>

      <footer class="site-footer">
        <div class="shell footer-grid">
          <p>Crypto Yield Archive is a historical registry, not an investment recommendation, APY ranking, or real-time dashboard.</p>
          <div class="footer-links">
            <a href={correctionUrl}>Submit correction</a>
            <a href={repoUrl}>GitHub</a>
            <a href="/methodology/">Methodology</a>
            <a href="/source-quality/">Source quality</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
