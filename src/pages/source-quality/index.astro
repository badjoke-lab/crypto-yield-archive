---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allEvidence, allOutcomes, allPlatforms, allTermsRisk } from '../../lib/data';
import type { EvidenceRecord, Outcome, Platform, TermsRisk } from '../../lib/data';

const platformById = new Map<string, Platform>(allPlatforms.map((platform) => [platform.id, platform]));
const platformName = (platformId: string) => platformById.get(platformId)?.canonical_name || platformId;
const platformSlug = (platformId: string) => platformById.get(platformId)?.slug;
const platformLink = (platformId: string) => platformSlug(platformId) ? `/platform/${platformSlug(platformId)}/` : '#';

const lowEvidence = allEvidence.filter((source: EvidenceRecord) => source.reliability === 'low');
const sourceTargets = allEvidence.filter((source: EvidenceRecord) => String(source.notes || '').toLowerCase().includes('verify') || String(source.notes || '').toLowerCase().includes('replace'));
const unknownOutcomes = allOutcomes.filter((outcome: Outcome) => outcome.outcome_status === 'unknown' || outcome.outcome_status === 'claims_ongoing');
const unknownTerms = allTermsRisk.filter((term: TermsRisk) => term.terms_status === 'unknown');

const platformsWithFewEvidence = allPlatforms
  .map((platform: Platform) => ({ platform, evidenceCount: allEvidence.filter((source: EvidenceRecord) => source.platform_id === platform.id).length }))
  .filter((item: { platform: Platform; evidenceCount: number }) => item.evidenceCount < 3);
---
<BaseLayout title="Source quality | Crypto Yield Archive" description="Evidence quality and unresolved outcome records in Crypto Yield Archive.">
  <section class="panel hero-panel">
    <p class="eyebrow">Transparency layer</p>
    <h1>Source quality</h1>
    <p>This page lists weak and unresolved records. Lower-reliability items are kept visible for transparency until stronger source coverage is available.</p>
    <div class="summary-grid">
      <div class="stat"><div class="label">Low evidence</div><div class="value">{lowEvidence.length}</div></div>
      <div class="stat"><div class="label">Source targets</div><div class="value">{sourceTargets.length}</div></div>
      <div class="stat"><div class="label">Unknown outcomes</div><div class="value">{unknownOutcomes.length}</div></div>
      <div class="stat"><div class="label">Unknown terms</div><div class="value">{unknownTerms.length}</div></div>
    </div>
  </section>

  <section class="grid" style="margin-top:18px;">
    <section class="panel card">
      <h2>Low reliability evidence</h2>
      <p>These entries should not be treated as the strongest support for a record. Prefer official, court, regulatory, archived, or high-quality reporting sources when available.</p>
      {lowEvidence.length ? (
        <div class="quality-list">
          {lowEvidence.map((source) => (
            <article class="quality-item evidence-low">
              <div class="chip-row small-gap">
                <span class="chip low">low</span>
                <span class="chip">{source.source_type}</span>
                <span class="chip">{source.claim_scope || 'claim'}</span>
              </div>
              <h3><a class="archive-link" href={source.url}>{source.title}</a></h3>
              <p><a class="archive-link" href={platformLink(source.platform_id)}>{platformName(source.platform_id)}</a> · {source.publisher}</p>
              {source.notes && <p class="muted detail-note">{source.notes}</p>}
            </article>
          ))}
        </div>
      ) : <p>No low-reliability evidence records.</p>}
    </section>

    <section class="panel card">
      <h2>Source improvement targets</h2>
      <p>These records mention source verification or replacement in their notes.</p>
      {sourceTargets.length ? (
        <div class="quality-list">
          {sourceTargets.map((source) => (
            <article class={`quality-item evidence-${source.reliability || 'unknown'}`}>
              <div class="chip-row small-gap">
                <span class={`chip ${source.reliability || ''}`}>{source.reliability}</span>
                <span class="chip">{source.source_type}</span>
              </div>
              <h3><a class="archive-link" href={source.url}>{source.title}</a></h3>
              <p><a class="archive-link" href={platformLink(source.platform_id)}>{platformName(source.platform_id)}</a> · {source.publisher}</p>
              {source.notes && <p class="muted detail-note">{source.notes}</p>}
            </article>
          ))}
        </div>
      ) : <p>No source improvement targets.</p>}
    </section>

    <section class="panel card">
      <h2>Unknown or ongoing customer outcomes</h2>
      {unknownOutcomes.length ? (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Platform</th><th>Outcome</th><th>Confidence</th><th>Notes</th></tr></thead>
            <tbody>
              {unknownOutcomes.map((outcome) => (
                <tr>
                  <td data-label="Platform"><a class="archive-link" href={platformLink(outcome.platform_id)}>{platformName(outcome.platform_id)}</a></td>
                  <td data-label="Outcome"><span class="chip medium">{outcome.outcome_status}</span></td>
                  <td data-label="Confidence"><span class={`chip ${outcome.confidence || ''}`}>{outcome.confidence}</span></td>
                  <td data-label="Notes">{outcome.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p>No unknown or ongoing outcomes.</p>}
    </section>

    <section class="panel card">
      <h2>Unknown terms-risk records</h2>
      {unknownTerms.length ? (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Platform</th><th>Terms status</th><th>Confidence</th><th>Reason</th></tr></thead>
            <tbody>
              {unknownTerms.map((term) => (
                <tr>
                  <td data-label="Platform"><a class="archive-link" href={platformLink(term.platform_id)}>{platformName(term.platform_id)}</a></td>
                  <td data-label="Terms"><span class="chip medium">{term.terms_status}</span></td>
                  <td data-label="Confidence"><span class={`chip ${term.confidence || ''}`}>{term.confidence}</span></td>
                  <td data-label="Reason">{term.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p>No unknown terms-risk records.</p>}
    </section>

    <section class="panel card">
      <h2>Platforms with fewer than 3 evidence records</h2>
      {platformsWithFewEvidence.length ? (
        <div class="quality-list">
          {platformsWithFewEvidence.map(({ platform, evidenceCount }) => (
            <article class="quality-item">
              <h3><a class="archive-link" href={`/platform/${platform.slug}/`}>{platform.canonical_name}</a></h3>
              <p>Evidence records: {evidenceCount}</p>
            </article>
          ))}
        </div>
      ) : <p>Every platform has at least 3 evidence records.</p>}
    </section>
  </section>
</BaseLayout>
