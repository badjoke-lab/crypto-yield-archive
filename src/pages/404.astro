---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Crypto Yield Archive" description="The requested Crypto Yield Archive page could not be found.">
  <section class="panel hero-panel">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page you requested does not exist, moved, or has not been added to the archive yet.</p>
    <div class="chip-row">
      <a class="ghost-button" href="/">Registry home</a>
      <a class="ghost-button" href="/timeline/">Timeline</a>
      <a class="ghost-button" href="/source-quality/">Source quality</a>
      <a class="ghost-button" href="/methodology/">Methodology</a>
    </div>
  </section>

  <section class="panel card" style="margin-top:18px;">
    <h2>Continue browsing</h2>
    <p>Start from the registry home to search by platform name, outcome, failure reason, or terms-risk classification.</p>
  </section>
</BaseLayout>
