---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/documents.css';
---
<BaseLayout title="Page not found | Crypto Yield Archive" description="The requested Crypto Yield Archive page could not be found.">
  <section class="not-found">
    <div>
      <p class="kicker">Archive error</p>
      <h1>Page not found</h1>
      <p class="lede">The requested page does not exist, moved, or has not been added to the archive.</p>
      <div class="not-found-links">
        <a href="/">Registry home →</a>
        <a href="/timeline/">Timeline →</a>
        <a href="/source-quality/">Source quality →</a>
        <a href="/methodology/">Methodology →</a>
      </div>
    </div>
    <div class="not-found-code" aria-hidden="true">404</div>
  </section>
</BaseLayout>
