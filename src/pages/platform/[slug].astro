---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPlatforms, getEvents, getEvidence, getOutcome, getProducts, getTermsRisk } from '../../lib/data';

export function getStaticPaths() {
  return allPlatforms.map((platform) => ({ params: { slug: platform.slug }, props: { platform } }));
}

const { platform } = Astro.props;
const events = getEvents(platform.id).sort((a, b) => String(a.event_date).localeCompare(String(b.event_date)));
const evidence = getEvidence(platform.id);
const outcome = getOutcome(platform.id);
const products = getProducts(platform.id);
const terms = getTermsRisk(platform.id);

const pageUrl = `https://cya.badjoke-lab.com/platform/${platform.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${platform.canonical_name} platform record`,
  name: platform.canonical_name,
  description: platform.summary,
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Crypto Yield Archive',
    url: 'https://cya.badjoke-lab.com/',
  },
  about: {
    '@type': 'Organization',
    name: platform.canonical_name,
    url: platform.official_url_original || undefined,
    sameAs: platform.archived_url ? [platform.archived_url] : undefined,
  },
  dateModified: platform.last_verified_at,
  keywords: [
    'crypto lending',
    'crypto yield',
    'customer outcome',
    platform.type,
    platform.status,
    platform.failure_reason,
    outcome?.outcome_status,
    terms?.terms_status,
  ].filter(Boolean).join(', '),
};

const evidenceById = new Map(evidence.map((source) => [source.id, source]));
const evidenceByEvent = new Map();
for (const source of evidence) {
  if (!source.event_id) continue;
  const list = evidenceByEvent.get(source.event_id) || [];
  list.push(source);
  evidenceByEvent.set(source.event_id, list);
}
const evidenceByClaim = Array.from(
  evidence.reduce((map, source) => {
    const key = source.claim_scope || 'other';
    const list = map.get(key) || [];
    list.push(source);
    map.set(key, list);
    return map;
  }, new Map())
).sort(([a], [b]) => String(a).localeCompare(String(b)));

const claimOptions = Array.from(new Set(evidence.map((source) => source.claim_scope || 'other'))).sort();
const reliabilityOptions = Array.from(new Set(evidence.map((source) => source.reliability || 'unknown'))).sort();
const sourceTypeOptions = Array.from(new Set(evidence.map((source) => source.source_type || 'other'))).sort();
const lowEvidence = evidence.filter((source) => source.reliability === 'low');
const sourceReviewEvidence = evidence.filter((source) => {
  const notes = String(source.notes || '').toLowerCase();
  return notes.includes('verify') || notes.includes('replace') || notes.includes('stronger source') || notes.includes('source review');
});

const relatedPlatforms = allPlatforms
  .filter((item) => item.id !== platform.id)
  .map((item) => {
    let score = 0;
    if (item.failure_reason && item.failure_reason === platform.failure_reason) score += 3;
    if (item.status && item.status === platform.status) score += 2;
    if (item.type && item.type === platform.type) score += 2;
    if (getOutcome(item.id)?.outcome_status === outcome?.outcome_status) score += 1;
    if (getTermsRisk(item.id)?.terms_status === terms?.terms_status) score += 1;
    return { platform: item, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || a.platform.canonical_name.localeCompare(b.platform.canonical_name))
  .slice(0, 5);
---
<BaseLayout title={`${platform.canonical_name} | Crypto Yield Archive`} description={platform.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="panel hero-panel">
    <p class="eyebrow">Platform dossier</p>
    <h1>{platform.canonical_name}</h1>
    <p>{platform.summary}</p>
    <div class="chip-row">
      <span class="chip">{platform.type}</span>
      <span class="chip">{platform.status}</span>
      <span class="chip">{platform.failure_reason || 'unknown'}</span>
      <span class={`chip ${platform.confidence || ''}`}>confidence: {platform.confidence || 'unknown'}</span>
    </div>
  </section>

  {(lowEvidence.length || sourceReviewEvidence.length) ? (
    <section class="panel card warning-card" style="margin-top:18px;">
      <h2>Source quality notice</h2>
      <p>This record includes evidence that needs stronger sourcing or source review. Treat those items as research leads rather than the strongest proof.</p>
      <div class="chip-row">
        <span class="chip low">low reliability: {lowEvidence.length}</span>
        <span class="chip medium">source review: {sourceReviewEvidence.length}</span>
      </div>
    </section>
  ) : null}

  <section class="grid two-col" style="margin-top:18px;">
    <div class="detail-stack">
      <section class="panel card">
        <h2>What happened?</h2>
        <p>{platform.what_happened || platform.summary}</p>
      </section>

      <section class="panel card">
        <div class="section-heading">
          <h2>Customer outcome</h2>
          <span class="chip">{outcome?.outcome_status || 'unknown'}</span>
        </div>
        {outcome ? (
          <>
            <p>{outcome.notes}</p>
            <div class="fact-grid compact-facts">
              <div class="fact"><div class="k">Estimated recovery</div><div class="v">{outcome.estimated_recovery_rate || '—'}</div></div>
              <div class="fact"><div class="k">Repayment started</div><div class="v">{outcome.repayment_started_at || '—'}</div></div>
              <div class="fact"><div class="k">Repayment completed</div><div class="v">{outcome.repayment_completed_at || '—'}</div></div>
              <div class="fact"><div class="k">Confidence</div><div class="v"><span class={`chip ${outcome.confidence || ''}`}>{outcome.confidence || '—'}</span></div></div>
            </div>
            {outcome.claim_process_url && <p><a class="archive-link" href={outcome.claim_process_url}>Claim / case process link</a></p>}
          </>
        ) : <p>Customer outcome has not been researched yet.</p>}
      </section>

      <section class="panel card">
        <div class="section-heading">
          <h2>Terms risk</h2>
          <span class="chip">{terms?.terms_status || 'unknown'}</span>
        </div>
        {terms ? (
          <>
            <p>{terms.notes}</p>
            <div class="fact-grid compact-facts">
              <div class="fact"><div class="k">Affected product</div><div class="v">{terms.affected_product || '—'}</div></div>
              <div class="fact"><div class="k">Confidence</div><div class="v"><span class={`chip ${terms.confidence || ''}`}>{terms.confidence || '—'}</span></div></div>
            </div>
            {terms.asset_ownership_interpretation && <p>{terms.asset_ownership_interpretation}</p>}
            {terms.source_evidence_id && evidenceById.has(terms.source_evidence_id) && (
              <p><a class="archive-link" href={evidenceById.get(terms.source_evidence_id).url}>Source: {evidenceById.get(terms.source_evidence_id).title}</a></p>
            )}
          </>
        ) : <p>Terms risk has not been researched yet.</p>}
      </section>

      <section class="panel card">
        <h2>Uncertainty</h2>
        <p>{platform.uncertainty_notes || 'Uncertainty notes have not been added yet.'}</p>
      </section>

      <section class="panel card">
        <h2>Timeline</h2>
        {events.length ? (
          <div class="timeline-list">
            {events.map((event) => {
              const eventEvidence = evidenceByEvent.get(event.id) || [];
              return (
                <article class="timeline-item">
                  <div class="timeline-date">{event.event_date}</div>
                  <div>
                    <div class="chip-row small-gap">
                      <span class="chip">{event.event_type}</span>
                      {event.impact_level && <span class="chip">impact: {event.impact_level}</span>}
                      {event.confidence && <span class={`chip ${event.confidence}`}>confidence: {event.confidence}</span>}
                      <span class="chip">sources: {eventEvidence.length}</span>
                    </div>
                    <h3>{event.title}</h3>
                    <p>{event.description}</p>
                    {event.notes && <p class="muted detail-note">{event.notes}</p>}
                    {eventEvidence.length ? (
                      <div class="nested-evidence">
                        <strong>Evidence for this event</strong>
                        {eventEvidence.map((source) => (
                          <p><a class="archive-link" href={source.url}>{source.title}</a> · {source.publisher} · {source.reliability}</p>
                        ))}
                      </div>
                    ) : <p class="muted detail-note">No direct evidence linked to this event yet.</p>}
                  </div>
                </article>
              );
            })}
          </div>
        ) : <p>No events yet.</p>}
      </section>

      <section class="panel card">
        <h2>Evidence dossier</h2>
        <p class="muted detail-note">Reliability labels describe source strength for this registry entry. Use the filters to inspect claim type, reliability, source type, and event-linked evidence.</p>
        <div class="controls" aria-label="Evidence filters">
          <label class="control-field">
            <span>Claim</span>
            <select id="evidenceClaimFilter">
              <option value="">All claims</option>
              {claimOptions.map((claim) => <option value={claim}>{claim}</option>)}
            </select>
          </label>
          <label class="control-field">
            <span>Reliability</span>
            <select id="evidenceReliabilityFilter">
              <option value="">All reliability</option>
              {reliabilityOptions.map((reliability) => <option value={reliability}>{reliability}</option>)}
            </select>
          </label>
          <label class="control-field">
            <span>Source type</span>
            <select id="evidenceSourceTypeFilter">
              <option value="">All source types</option>
              {sourceTypeOptions.map((sourceType) => <option value={sourceType}>{sourceType}</option>)}
            </select>
          </label>
          <label class="control-field">
            <span>Event link</span>
            <select id="evidenceEventLinkedFilter">
              <option value="">All evidence</option>
              <option value="linked">Event-linked only</option>
              <option value="unlinked">Unlinked only</option>
            </select>
          </label>
          <button id="evidenceClearFilters" class="ghost-button" type="button">Clear</button>
        </div>
        <div class="registry-count" aria-live="polite">
          Showing <strong id="evidenceVisibleCount">{evidence.length}</strong> of <strong>{evidence.length}</strong> evidence records
        </div>
        {evidenceByClaim.length ? (
          <div class="evidence-claim-groups">
            {evidenceByClaim.map(([claim, sources]) => (
              <section class="claim-group">
                <div class="section-heading"><h3>{claim}</h3><span class="chip">{sources.length} sources</span></div>
                <div class="evidence-list">
                  {sources.map((source) => (
                    <article
                      class={`evidence-item evidence-${source.reliability || 'unknown'}`}
                      data-evidence-item="true"
                      data-claim={source.claim_scope || 'other'}
                      data-reliability={source.reliability || 'unknown'}
                      data-source-type={source.source_type || 'other'}
                      data-event-linked={source.event_id ? 'linked' : 'unlinked'}
                    >
                      <div class="chip-row small-gap">
                        <span class="chip">{source.source_type}</span>
                        <span class={`chip ${source.reliability || ''}`}>reliability: {source.reliability}</span>
                        {source.event_id && <span class="chip">event linked</span>}
                      </div>
                      <h3><a class="archive-link" href={source.url}>{source.title}</a></h3>
                      <p>{source.publisher}{source.published_at ? ` · ${source.published_at}` : ''}</p>
                      {source.archived_url && <p><a class="archive-link" href={source.archived_url}>Archived version</a></p>}
                      {source.notes && <p class="muted detail-note">{source.notes}</p>}
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : <p>No evidence yet.</p>}
        <p id="evidenceEmptyState" class="empty-state" hidden>No evidence records match the current filters.</p>
      </section>

      {relatedPlatforms.length ? (
        <section class="panel card">
          <h2>Related platforms</h2>
          <p class="muted detail-note">Related by shared status, type, failure reason, outcome, or terms-risk classification.</p>
          <div class="related-grid">
            {relatedPlatforms.map(({ platform: related, score }) => (
              <a class="related-card" href={`/platform/${related.slug}/`}>
                <strong>{related.canonical_name}</strong>
                <span>{related.status} · {related.failure_reason || 'unknown'}</span>
                <small>relation score: {score}</small>
              </a>
            ))}
          </div>
        </section>
      ) : null}
    </div>

    <aside class="panel card sticky-side">
      <h2>Facts</h2>
      <div class="fact-grid">
        <div class="fact"><div class="k">Launch</div><div class="v">{platform.launch_date || '—'}</div></div>
        <div class="fact"><div class="k">End</div><div class="v">{platform.end_date || '—'}</div></div>
        <div class="fact"><div class="k">Origin</div><div class="v">{platform.country_or_origin || '—'}</div></div>
        <div class="fact"><div class="k">Confidence</div><div class="v"><span class={`chip ${platform.confidence || ''}`}>{platform.confidence || '—'}</span></div></div>
        <div class="fact"><div class="k">Domain</div><div class="v">{platform.official_domain_original || '—'}</div></div>
        <div class="fact"><div class="k">URL status</div><div class="v">{platform.official_url_status || '—'}</div></div>
      </div>

      <h3 style="margin-top:18px;">URL history</h3>
      <div class="side-links">
        {platform.official_url_original && <a class="archive-link" href={platform.official_url_original}>Original URL</a>}
        {platform.archived_url && <a class="archive-link" href={platform.archived_url}>Web Archive</a>}
      </div>

      <h3 style="margin-top:18px;">Products</h3>
      {products.length ? (
        <div class="product-list">
          {products.map((product) => (
            <div class="fact">
              <div class="k">{product.product_type}</div>
              <div class="v"><strong>{product.product_name}</strong></div>
              {product.risk_notes && <p>{product.risk_notes}</p>}
            </div>
          ))}
        </div>
      ) : <p>No product profiles yet.</p>}
    </aside>
  </section>

  <script is:inline>
    const evidenceClaimFilter = document.querySelector('#evidenceClaimFilter');
    const evidenceReliabilityFilter = document.querySelector('#evidenceReliabilityFilter');
    const evidenceSourceTypeFilter = document.querySelector('#evidenceSourceTypeFilter');
    const evidenceEventLinkedFilter = document.querySelector('#evidenceEventLinkedFilter');
    const evidenceClearButton = document.querySelector('#evidenceClearFilters');
    const evidenceVisibleCount = document.querySelector('#evidenceVisibleCount');
    const evidenceEmptyState = document.querySelector('#evidenceEmptyState');
    const evidenceItems = Array.from(document.querySelectorAll('[data-evidence-item="true"]'));

    function applyEvidenceFilters() {
      const claim = evidenceClaimFilter.value;
      const reliability = evidenceReliabilityFilter.value;
      const sourceType = evidenceSourceTypeFilter.value;
      const eventLinked = evidenceEventLinkedFilter.value;
      let shown = 0;

      for (const item of evidenceItems) {
        const matchesClaim = !claim || item.dataset.claim === claim;
        const matchesReliability = !reliability || item.dataset.reliability === reliability;
        const matchesSourceType = !sourceType || item.dataset.sourceType === sourceType;
        const matchesEventLinked = !eventLinked || item.dataset.eventLinked === eventLinked;
        const isVisible = matchesClaim && matchesReliability && matchesSourceType && matchesEventLinked;
        item.hidden = !isVisible;
        if (isVisible) shown += 1;
      }

      evidenceVisibleCount.textContent = String(shown);
      evidenceEmptyState.hidden = shown !== 0;
    }

    evidenceClaimFilter?.addEventListener('change', applyEvidenceFilters);
    evidenceReliabilityFilter?.addEventListener('change', applyEvidenceFilters);
    evidenceSourceTypeFilter?.addEventListener('change', applyEvidenceFilters);
    evidenceEventLinkedFilter?.addEventListener('change', applyEvidenceFilters);
    evidenceClearButton?.addEventListener('click', () => {
      evidenceClaimFilter.value = '';
      evidenceReliabilityFilter.value = '';
      evidenceSourceTypeFilter.value = '';
      evidenceEventLinkedFilter.value = '';
      applyEvidenceFilters();
    });
  </script>
</BaseLayout>
