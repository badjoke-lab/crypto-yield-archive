---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPlatforms, getEvents, getEvidence, getOutcome, getProducts, getTermsRisk, label } from '../../lib/data';

export function getStaticPaths() { return allPlatforms.map((platform) => ({ params: { slug: platform.slug }, props: { platform } })); }
const { platform } = Astro.props;
const events = getEvents(platform.id).sort((a, b) => String(a.event_date).localeCompare(String(b.event_date)));
const evidence = getEvidence(platform.id);
const outcome = getOutcome(platform.id);
const products = getProducts(platform.id);
const terms = getTermsRisk(platform.id);
const text = (value) => String(value || '').toLowerCase();
const eventText = events.map((event) => `${event.event_type || ''} ${event.title || ''} ${event.description || ''}`).join(' ').toLowerCase();
const concerns = [];
if (!outcome || !outcome.outcome_status || outcome.outcome_status === 'unknown') concerns.push(['Customer outcome', 'Unresolved']);
if (!terms || !terms.terms_status || terms.terms_status === 'unknown') concerns.push(['Terms / asset treatment', 'Unresolved']);
if (text(platform.uncertainty_notes) && !text(platform.uncertainty_notes).includes('no material')) concerns.push(['Known unknowns', 'Recorded']);
if (/withdraw|suspend|freeze|halt/.test(eventText)) concerns.push(['Withdrawal / service restriction', 'Material event recorded']);
if (/regulat|enforcement|sec |fca |fsa |order|fine/.test(eventText)) concerns.push(['Regulatory record', 'Material event recorded']);
if (/bankrupt|insolven|liquidat|restructur|failure/.test(eventText)) concerns.push(['Failure / insolvency chain', 'Material event recorded']);
if (/apy|apr|yield|interest|reward|promot/.test(eventText)) concerns.push(['Yield history', 'Material yield event recorded']);
const lowEvidence = evidence.filter((source) => source.reliability === 'low');
const sourceReviewEvidence = evidence.filter((source) => { const notes = text(source.notes); return notes.includes('verify') || notes.includes('replace') || notes.includes('stronger source') || notes.includes('source review'); });
const pageUrl = `https://cya.badjoke-lab.com/platform/${platform.slug}/`;
const jsonLd = { '@context':'https://schema.org','@type':'Article',headline:`${platform.canonical_name} platform record`,name:platform.canonical_name,description:platform.summary,url:pageUrl,isPartOf:{'@type':'WebSite',name:'Crypto Yield Archive',url:'https://cya.badjoke-lab.com/'},dateModified:platform.last_verified_at };
---
<BaseLayout title={`${platform.canonical_name} | Crypto Yield Archive`} description={platform.summary}>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<nav class="record-breadcrumb" aria-label="Breadcrumb"><a href="/">Registry</a><span>/</span><span>{platform.canonical_name}</span></nav>
<header class="platform-head"><div><p class="kicker">{label(platform.type)} · {platform.country_or_origin || 'Origin unknown'}</p><h1>{platform.canonical_name}</h1><p class="platform-summary">{platform.summary}</p>{platform.aliases?.length ? <p class="platform-aliases">Also known as: {platform.aliases.join(', ')}</p> : null}</div><dl class="platform-status-grid" aria-label="Platform status summary"><div><dt>Status</dt><dd>{label(platform.status)}</dd></div><div><dt>Outcome</dt><dd>{label(outcome?.outcome_status || 'unknown')}</dd></div><div><dt>Confidence</dt><dd>{label(platform.confidence || 'unknown')}</dd></div><div><dt>Last verified</dt><dd>{platform.last_verified_at || '—'}</dd></div></dl></header>
<section class="platform-record-strip" aria-label="Platform record facts"><div><span>Launch</span><strong>{platform.launch_date || '—'}</strong></div><div><span>End</span><strong>{platform.end_date || '—'}</strong></div><div><span>Failure reason</span><strong>{label(platform.failure_reason)}</strong></div><div><span>Events</span><strong>{events.length}</strong></div><div><span>Evidence</span><strong>{evidence.length}</strong></div><div><span>Products</span><strong>{products.length}</strong></div></section>
<aside class="source-notice" aria-labelledby="material-concerns-title"><div><p class="kicker">Material concerns</p><h2 id="material-concerns-title">Status is not a safety endorsement.</h2><p>These flags are derived from reviewed canonical records. They identify material events or unresolved questions; they are not a proprietary safety score.</p></div><dl>{concerns.length ? concerns.map(([name,state]) => <div><dt>{name}</dt><dd>{state}</dd></div>) : <div><dt>Current derived flags</dt><dd>None. This is not a recommendation or finding of safety.</dd></div>}</dl></aside>
{(lowEvidence.length || sourceReviewEvidence.length) ? <aside class="source-notice" aria-labelledby="source-notice-title"><div><p class="kicker">Source quality notice</p><h2 id="source-notice-title">Use weaker sources with caution.</h2><p>This record includes evidence that needs stronger sourcing or source review.</p></div><dl><div><dt>Low reliability</dt><dd>{lowEvidence.length}</dd></div><div><dt>Needs review</dt><dd>{sourceReviewEvidence.length}</dd></div></dl></aside> : null}
<div class="platform-layout"><article class="platform-main">
<section class="record-section" aria-labelledby="what-happened-title"><div class="record-section-head"><p class="kicker">Case summary</p><h2 id="what-happened-title">What happened</h2></div><p class="record-prose">{platform.what_happened || platform.summary}</p></section>
<section class="record-section split-record" aria-labelledby="outcome-title"><div class="record-section-head"><p class="kicker">Customer result</p><h2 id="outcome-title">Customer outcome</h2></div><div class="record-section-body"><p class="record-state">{label(outcome?.outcome_status || 'unknown')}</p>{outcome ? <><p>{outcome.notes}</p><dl class="record-ledger"><div><dt>Estimated recovery</dt><dd>{label(outcome.estimated_recovery_rate)}</dd></div><div><dt>Repayment started</dt><dd>{outcome.repayment_started_at || '—'}</dd></div><div><dt>Repayment completed</dt><dd>{outcome.repayment_completed_at || '—'}</dd></div><div><dt>Confidence</dt><dd>{label(outcome.confidence)}</dd></div></dl>{outcome.claim_process_url && <p><a class="archive-link" href={outcome.claim_process_url}>Claim or case process →</a></p>}</> : <p>Customer outcome has not been researched yet.</p>}</div></section>
<section class="record-section split-record" aria-labelledby="terms-title"><div class="record-section-head"><p class="kicker">Asset treatment</p><h2 id="terms-title">Terms risk</h2></div><div class="record-section-body"><p class="record-state">{label(terms?.terms_status || 'unknown')}</p>{terms ? <><p>{terms.notes}</p><dl class="record-ledger"><div><dt>Affected product</dt><dd>{terms.affected_product || '—'}</dd></div><div><dt>Confidence</dt><dd>{label(terms.confidence)}</dd></div></dl>{terms.asset_ownership_interpretation && <p>{terms.asset_ownership_interpretation}</p>}</> : <p>Terms risk has not been researched yet.</p>}</div></section>
<section class="record-section split-record" aria-labelledby="uncertainty-title"><div class="record-section-head"><p class="kicker">Known unknowns</p><h2 id="uncertainty-title">Uncertainty</h2></div><div class="record-section-body"><p>{platform.uncertainty_notes || 'Uncertainty notes have not been added yet.'}</p></div></section>
<section class="record-section" aria-labelledby="timeline-title"><div class="record-section-head"><p class="kicker">Chronology</p><h2 id="timeline-title">Historical record</h2></div>{events.length ? <div class="platform-timeline">{events.map((event) => <article class="timeline-entry"><time>{event.event_date || 'Date unknown'}</time><div><p class="kicker">{label(event.event_type)}</p><h3>{event.title}</h3><p>{event.description}</p></div></article>)}</div> : <p>No events recorded.</p>}</section>
</article><aside class="platform-sidebar"><section class="sidebar-card"><p class="kicker">Record scope</p><h2>Evidence coverage</h2><dl class="record-ledger"><div><dt>Events</dt><dd>{events.length}</dd></div><div><dt>Evidence</dt><dd>{evidence.length}</dd></div><div><dt>Products</dt><dd>{products.length}</dd></div></dl></section></aside></div>
</BaseLayout>