---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTermsRisk, allPlatforms, label } from '../../lib/data';

const platformById = new Map(allPlatforms.map((platform) => [platform.id, platform]));
const groups = Array.from(new Set(allTermsRisk.map((term) => term.terms_status || 'unknown')))
  .sort()
  .map((status) => ({ status, records: allTermsRisk.filter((term) => (term.terms_status || 'unknown') === status) }));
const unknown = allTermsRisk.filter((term) => term.terms_status === 'unknown').length;
---
<BaseLayout title="Terms risk | Crypto Yield Archive" description="Asset ownership and terms-risk classifications across crypto lending and yield platforms.">
  <header class="registry-page-head">
    <div>
      <p class="kicker">Asset treatment ledger</p>
      <h1>Terms risk</h1>
      <p class="lede">Track whether deposited assets were treated as customer-owned, platform-owned, unclear, product-dependent, or unknown.</p>
    </div>
    <dl class="registry-page-facts">
      <div><dt>Terms classes</dt><dd>{groups.length}</dd></div>
      <div><dt>Terms records</dt><dd>{allTermsRisk.length}</dd></div>
      <div><dt>Platforms</dt><dd>{allPlatforms.length}</dd></div>
      <div><dt>Unknown</dt><dd>{unknown}</dd></div>
    </dl>
  </header>

  <nav class="registry-index" aria-label="Terms risk groups">
    {groups.map(({ status, records }, index) => <a href={`#terms-${status}`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{label(status)}</strong><em>{records.length}</em></a>)}
  </nav>

  <div class="registry-groups">
    {groups.map(({ status, records }) => (
      <section id={`terms-${status}`} class="registry-group">
        <header class="registry-group-head"><div><p class="kicker">Terms class</p><h2>{label(status)}</h2></div><strong>{records.length} records</strong></header>
        <div class="table-wrap"><table class="cross-ledger"><thead><tr><th>Platform</th><th>Affected product</th><th>Confidence</th><th>Interpretation</th><th>Notes</th></tr></thead><tbody>
          {records.map((term) => {
            const platform = platformById.get(term.platform_id);
            return <tr><td data-label="Platform" class="name-cell"><a href={platform ? `/platform/${platform.slug}/` : '#'}><strong>{platform?.canonical_name || term.platform_id}</strong></a><small>{label(platform?.type || 'unknown')} · {label(platform?.status || 'unknown')}</small></td><td data-label="Affected product">{term.affected_product || '—'}</td><td data-label="Confidence">{label(term.confidence || 'unknown')}</td><td data-label="Interpretation">{term.asset_ownership_interpretation || '—'}</td><td data-label="Notes">{term.notes}</td></tr>;
          })}
        </tbody></table></div>
      </section>
    ))}
  </div>
</BaseLayout>
