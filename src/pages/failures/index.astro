---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPlatforms, getOutcome } from '../../lib/data';

const groups = Array.from(new Set(allPlatforms.map((platform) => platform.failure_reason || 'unknown')))
  .sort()
  .map((reason) => ({ reason, platforms: allPlatforms.filter((platform) => (platform.failure_reason || 'unknown') === reason) }));
const assigned = allPlatforms.filter((platform) => platform.failure_reason).length;
const unknown = allPlatforms.length - assigned;
---
<BaseLayout title="Failure reasons | Crypto Yield Archive" description="Cross-platform failure reason groups for crypto lending and yield platforms.">
  <header class="registry-page-head">
    <div>
      <p class="kicker">Primary historical driver</p>
      <h1>Failure reasons</h1>
      <p class="lede">Platforms are grouped by the primary reason currently assigned in the registry. These labels summarize the main driver, not the entire failure chain.</p>
    </div>
    <dl class="registry-page-facts">
      <div><dt>Reason groups</dt><dd>{groups.length}</dd></div>
      <div><dt>Platforms</dt><dd>{allPlatforms.length}</dd></div>
      <div><dt>Assigned</dt><dd>{assigned}</dd></div>
      <div><dt>Unknown</dt><dd>{unknown}</dd></div>
    </dl>
  </header>

  <nav class="registry-index" aria-label="Failure reason groups">
    {groups.map(({ reason, platforms }, index) => <a href={`#failure-${reason}`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{reason}</strong><em>{platforms.length}</em></a>)}
  </nav>

  <div class="registry-groups">
    {groups.map(({ reason, platforms }) => (
      <section id={`failure-${reason}`} class="registry-group">
        <header class="registry-group-head"><div><p class="kicker">Failure class</p><h2>{reason}</h2></div><strong>{platforms.length} platforms</strong></header>
        <div class="table-wrap"><table class="cross-ledger"><thead><tr><th>Platform</th><th>Status</th><th>Outcome</th><th>Confidence</th><th>Origin</th></tr></thead><tbody>
          {platforms.map((platform) => {
            const outcome = getOutcome(platform.id);
            return <tr><td data-label="Platform" class="name-cell"><a href={`/platform/${platform.slug}/`}><strong>{platform.canonical_name}</strong></a><small>{platform.type} · {platform.official_domain_original || 'no domain'}</small></td><td data-label="Status">{platform.status}</td><td data-label="Outcome">{outcome?.outcome_status || 'unknown'}</td><td data-label="Confidence">{platform.confidence || 'unknown'}</td><td data-label="Origin">{platform.country_or_origin || '—'}</td></tr>;
          })}
        </tbody></table></div>
      </section>
    ))}
  </div>
</BaseLayout>
