---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allPlatforms, allEvents, allEvidence, allOutcomes, getOutcome, label } from '../lib/data';

const claimsOngoing = allOutcomes.filter((outcome) => outcome.outcome_status === 'claims_ongoing').length;
const latestVerified = allPlatforms.map((platform) => platform.last_verified_at).filter(Boolean).sort().at(-1) || '—';
const recentlyReviewed = [...allPlatforms]
  .sort((a, b) => String(b.last_verified_at || '').localeCompare(String(a.last_verified_at || '')) || a.canonical_name.localeCompare(b.canonical_name))
  .slice(0, 6);
const ongoingClaims = allPlatforms
  .filter((platform) => getOutcome(platform.id)?.outcome_status === 'claims_ongoing')
  .sort((a, b) => String(b.last_verified_at || '').localeCompare(String(a.last_verified_at || '')) || a.canonical_name.localeCompare(b.canonical_name))
  .slice(0, 6);
const majorFailures = allPlatforms
  .filter((platform) => platform.failure_reason && platform.failure_reason !== 'unknown')
  .sort((a, b) => String(b.end_date || '').localeCompare(String(a.end_date || '')) || a.canonical_name.localeCompare(b.canonical_name))
  .slice(0, 6);
const outcomeStatuses = Array.from(new Set(allOutcomes.map((outcome) => outcome.outcome_status).filter(Boolean))).sort();

function recordCard(platform) {
  const outcome = getOutcome(platform.id);
  return {
    href: `/platform/${platform.slug}/`,
    name: platform.canonical_name,
    meta: [label(platform.status), label(outcome?.outcome_status || 'unknown'), platform.last_verified_at ? `Reviewed ${platform.last_verified_at}` : null].filter(Boolean).join(' · '),
    summary: platform.summary,
  };
}
---
<BaseLayout>
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-intro-copy">
      <p class="kicker">Crypto lending history</p>
      <h1 id="home-title">The historical record of crypto lending, Earn products, and customer outcomes.</h1>
      <p class="lede">Crypto Yield Archive documents what happened after users deposited assets into centralized lending and yield platforms. It connects platform history, customer outcome, terms risk, failure chain, and evidence.</p>
      <div class="home-primary-actions">
        <a class="primary-action" href="/platforms/">Browse all platforms</a>
        <a class="secondary-action" href="/failures/">Review failure cases</a>
      </div>
    </div>
    <dl class="home-facts" aria-label="Registry summary">
      <div><dt>Platforms</dt><dd>{allPlatforms.length}</dd></div>
      <div><dt>Events</dt><dd>{allEvents.length}</dd></div>
      <div><dt>Evidence</dt><dd>{allEvidence.length}</dd></div>
      <div><dt>Claims ongoing</dt><dd>{claimsOngoing}</dd></div>
    </dl>
  </section>

  <section class="archive-note" aria-label="Registry scope note">
    <span>Evidence-based static registry</span>
    <span>Last verified {latestVerified}</span>
    <span>Not an APY ranking</span>
  </section>

  <section class="home-record-section" aria-labelledby="recent-title">
    <div class="section-heading"><div><p class="kicker">Recently reviewed</p><h2 id="recent-title">Latest platform reviews</h2></div><a href="/platforms/?sort=reviewed-desc">Browse all platforms →</a></div>
    <div class="home-record-grid">{recentlyReviewed.map((platform) => { const card = recordCard(platform); return <a class="home-record-card" href={card.href}><strong>{card.name}</strong><span>{card.meta}</span><p>{card.summary}</p></a>; })}</div>
  </section>

  <section class="home-record-section" aria-labelledby="claims-title">
    <div class="section-heading"><div><p class="kicker">Customer outcomes</p><h2 id="claims-title">Ongoing customer claims</h2></div><a href="/platforms/?outcome=claims_ongoing">View all ongoing claims →</a></div>
    {ongoingClaims.length ? <div class="home-record-grid">{ongoingClaims.map((platform) => { const card = recordCard(platform); return <a class="home-record-card" href={card.href}><strong>{card.name}</strong><span>{card.meta}</span><p>{card.summary}</p></a>; })}</div> : <p class="empty-state">No reviewed platform currently matches this outcome.</p>}
  </section>

  <section class="home-record-section" aria-labelledby="failures-title">
    <div class="section-heading"><div><p class="kicker">Major cases</p><h2 id="failures-title">Failure records</h2></div><a href="/failures/">Open failure analysis →</a></div>
    <div class="home-record-grid">{majorFailures.map((platform) => { const card = recordCard(platform); return <a class="home-record-card" href={card.href}><strong>{card.name}</strong><span>{label(platform.failure_reason)} · {card.meta}</span><p>{card.summary}</p></a>; })}</div>
  </section>

  <section class="home-outcome-section" aria-labelledby="outcome-browse-title">
    <div class="section-heading"><div><p class="kicker">Browse by outcome</p><h2 id="outcome-browse-title">Follow what customers ultimately received</h2></div><p>Outcome filters open the dedicated registry with the selected state preserved in the URL.</p></div>
    <div class="outcome-link-grid">{outcomeStatuses.map((status) => <a href={`/platforms/?outcome=${encodeURIComponent(status)}`}><strong>{label(status)}</strong><span>Browse matching platform records →</span></a>)}</div>
  </section>

  <section class="methodology-summary" aria-labelledby="methodology-summary-title">
    <div><p class="kicker">Methodology</p><h2 id="methodology-summary-title">A reviewed historical archive, not a live yield comparison.</h2><p>CYA separates platform identity, events, evidence, customer outcomes, products, and terms-risk interpretation. Unknowns and weaker evidence remain visible.</p></div>
    <a class="secondary-action" href="/methodology/">Read the methodology</a>
  </section>

  <section class="home-support-callout" aria-labelledby="home-support-title">
    <div><p class="kicker">Independent maintenance</p><h2 id="home-support-title">Help maintain customer-outcome records</h2><p>Support source review, court-document checks, corrections, broken-link replacement, and long-term archive maintenance. Support does not influence classifications or evidence standards.</p></div>
    <a class="support-action" href="/support/">Support CYA</a>
  </section>
</BaseLayout>
