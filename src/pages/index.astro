---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allPlatforms, allEvents, allEvidence, allOutcomes, getOutcome, getTermsRisk } from '../lib/data';

const statusOptions = Array.from(new Set(allPlatforms.map((platform) => platform.status))).sort();
const outcomeOptions = Array.from(new Set(allPlatforms.map((platform) => getOutcome(platform.id)?.outcome_status || 'unknown'))).sort();
const failureOptions = Array.from(new Set(allPlatforms.map((platform) => platform.failure_reason || 'unknown'))).sort();
const termsOptions = Array.from(new Set(allPlatforms.map((platform) => getTermsRisk(platform.id)?.terms_status || 'unknown'))).sort();

function years(platform) {
  const start = platform.launch_date ? String(platform.launch_date).slice(0, 4) : '—';
  const end = platform.end_date ? String(platform.end_date).slice(0, 4) : '';
  return `${start}${end ? `–${end}` : '–'}`;
}

function searchText(platform) {
  const outcome = getOutcome(platform.id);
  const terms = getTermsRisk(platform.id);
  return [
    platform.canonical_name,
    platform.slug,
    platform.type,
    platform.status,
    platform.failure_reason,
    platform.official_domain_original,
    outcome?.outcome_status,
    terms?.terms_status,
    ...(platform.aliases || []),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
}
---
<BaseLayout>
  <section class="panel hero-panel">
    <p class="eyebrow">Historical registry · Astro static build</p>
    <h1>What happened after users deposited assets into crypto yield platforms?</h1>
    <p>Crypto Yield Archive tracks lending, Earn, and yield platforms by platform history, customer outcome, terms risk, failure chain, and evidence.</p>
    <div class="summary-grid">
      <div class="stat"><div class="label">Platforms</div><div class="value">{allPlatforms.length}</div></div>
      <div class="stat"><div class="label">Events</div><div class="value">{allEvents.length}</div></div>
      <div class="stat"><div class="label">Evidence</div><div class="value">{allEvidence.length}</div></div>
      <div class="stat"><div class="label">Outcomes</div><div class="value">{allOutcomes.length}</div></div>
    </div>
  </section>

  <section class="panel registry-panel" style="margin-top:18px;">
    <div class="controls" aria-label="Registry filters">
      <label class="control-field search-field">
        <span>Search</span>
        <input id="registrySearch" type="search" placeholder="Search name, alias, domain, type, outcome…" autocomplete="off" />
      </label>
      <label class="control-field">
        <span>Status</span>
        <select id="statusFilter">
          <option value="">All status</option>
          {statusOptions.map((status) => <option value={status}>{status}</option>)}
        </select>
      </label>
      <label class="control-field">
        <span>Outcome</span>
        <select id="outcomeFilter">
          <option value="">All outcomes</option>
          {outcomeOptions.map((outcome) => <option value={outcome}>{outcome}</option>)}
        </select>
      </label>
      <label class="control-field">
        <span>Failure</span>
        <select id="failureFilter">
          <option value="">All failure reasons</option>
          {failureOptions.map((failure) => <option value={failure}>{failure}</option>)}
        </select>
      </label>
      <label class="control-field">
        <span>Terms</span>
        <select id="termsFilter">
          <option value="">All terms status</option>
          {termsOptions.map((term) => <option value={term}>{term}</option>)}
        </select>
      </label>
      <label class="control-field">
        <span>Sort</span>
        <select id="sortSelect">
          <option value="name-asc">Name A–Z</option>
          <option value="name-desc">Name Z–A</option>
          <option value="launch-desc">Launch newest</option>
          <option value="launch-asc">Launch oldest</option>
          <option value="status-asc">Status A–Z</option>
          <option value="outcome-asc">Outcome A–Z</option>
          <option value="confidence-desc">Confidence high first</option>
        </select>
      </label>
      <button id="copyCurrentView" class="ghost-button" type="button">Copy view link</button>
      <button id="clearFilters" class="ghost-button" type="button">Clear</button>
    </div>

    <div class="registry-count" aria-live="polite">
      Showing <strong id="visibleCount">{allPlatforms.length}</strong> of <strong>{allPlatforms.length}</strong> platforms
      <span id="copyStatus" class="copy-status" aria-live="polite"></span>
    </div>

    <div class="table-wrap">
      <table id="registryTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Status</th>
            <th>Failure reason</th>
            <th>Customer outcome</th>
            <th>Terms risk</th>
            <th>Years</th>
            <th>Domain</th>
            <th>Archive</th>
          </tr>
        </thead>
        <tbody id="registryBody">
          {allPlatforms.map((platform) => {
            const outcome = getOutcome(platform.id);
            const terms = getTermsRisk(platform.id);
            return (
              <tr
                data-row="platform"
                data-search={searchText(platform)}
                data-name={platform.canonical_name}
                data-status={platform.status}
                data-outcome={outcome?.outcome_status || 'unknown'}
                data-failure={platform.failure_reason || 'unknown'}
                data-terms={terms?.terms_status || 'unknown'}
                data-launch={platform.launch_date || ''}
                data-confidence={platform.confidence || 'low'}
              >
                <td class="name-cell" data-label="Name"><a href={`/platform/${platform.slug}/`}><strong>{platform.canonical_name}</strong></a><small>{(platform.aliases || []).join(', ') || platform.slug}</small></td>
                <td data-label="Type"><span class="chip">{platform.type}</span></td>
                <td data-label="Status"><span class="chip">{platform.status}</span></td>
                <td data-label="Failure reason"><span class="chip">{platform.failure_reason || '—'}</span></td>
                <td data-label="Customer outcome"><span class="chip">{outcome?.outcome_status || 'unknown'}</span></td>
                <td data-label="Terms risk"><span class="chip">{terms?.terms_status || 'unknown'}</span></td>
                <td data-label="Years">{years(platform)}</td>
                <td data-label="Domain">{platform.official_domain_original || '—'}</td>
                <td data-label="Archive">{platform.archived_url ? <a class="archive-link" href={platform.archived_url}>Archive</a> : <span class="muted">—</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p id="emptyState" class="empty-state" hidden>No platforms match the current filters.</p>
    </div>
  </section>

  <script is:inline>
    const searchInput = document.querySelector('#registrySearch');
    const statusFilter = document.querySelector('#statusFilter');
    const outcomeFilter = document.querySelector('#outcomeFilter');
    const failureFilter = document.querySelector('#failureFilter');
    const termsFilter = document.querySelector('#termsFilter');
    const sortSelect = document.querySelector('#sortSelect');
    const copyButton = document.querySelector('#copyCurrentView');
    const clearButton = document.querySelector('#clearFilters');
    const visibleCount = document.querySelector('#visibleCount');
    const emptyState = document.querySelector('#emptyState');
    const copyStatus = document.querySelector('#copyStatus');
    const tbody = document.querySelector('#registryBody');
    const rows = Array.from(document.querySelectorAll('[data-row="platform"]'));
    const confidenceRank = { high: 3, medium: 2, low: 1 };

    function compareRows(a, b, sort) {
      if (sort === 'name-desc') return b.dataset.name.localeCompare(a.dataset.name);
      if (sort === 'launch-desc') return String(b.dataset.launch).localeCompare(String(a.dataset.launch));
      if (sort === 'launch-asc') return String(a.dataset.launch || '9999').localeCompare(String(b.dataset.launch || '9999'));
      if (sort === 'status-asc') return a.dataset.status.localeCompare(b.dataset.status) || a.dataset.name.localeCompare(b.dataset.name);
      if (sort === 'outcome-asc') return a.dataset.outcome.localeCompare(b.dataset.outcome) || a.dataset.name.localeCompare(b.dataset.name);
      if (sort === 'confidence-desc') return (confidenceRank[b.dataset.confidence] || 0) - (confidenceRank[a.dataset.confidence] || 0) || a.dataset.name.localeCompare(b.dataset.name);
      return a.dataset.name.localeCompare(b.dataset.name);
    }

    function readControls() {
      return {
        q: searchInput.value.trim(),
        status: statusFilter.value,
        outcome: outcomeFilter.value,
        failure: failureFilter.value,
        terms: termsFilter.value,
        sort: sortSelect.value,
      };
    }

    function writeUrlState(controls) {
      const params = new URLSearchParams();
      if (controls.q) params.set('q', controls.q);
      if (controls.status) params.set('status', controls.status);
      if (controls.outcome) params.set('outcome', controls.outcome);
      if (controls.failure) params.set('failure', controls.failure);
      if (controls.terms) params.set('terms', controls.terms);
      if (controls.sort && controls.sort !== 'name-asc') params.set('sort', controls.sort);
      const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
      window.history.replaceState(null, '', nextUrl);
    }

    function restoreFromUrl() {
      const params = new URLSearchParams(window.location.search);
      searchInput.value = params.get('q') || '';
      statusFilter.value = params.get('status') || '';
      outcomeFilter.value = params.get('outcome') || '';
      failureFilter.value = params.get('failure') || '';
      termsFilter.value = params.get('terms') || '';
      sortSelect.value = params.get('sort') || 'name-asc';
    }

    function applyFilters() {
      const controls = readControls();
      const query = controls.q.toLowerCase();
      let shown = 0;

      for (const row of [...rows].sort((a, b) => compareRows(a, b, controls.sort))) {
        const matchesQuery = !query || row.dataset.search.includes(query);
        const matchesStatus = !controls.status || row.dataset.status === controls.status;
        const matchesOutcome = !controls.outcome || row.dataset.outcome === controls.outcome;
        const matchesFailure = !controls.failure || row.dataset.failure === controls.failure;
        const matchesTerms = !controls.terms || row.dataset.terms === controls.terms;
        const isVisible = matchesQuery && matchesStatus && matchesOutcome && matchesFailure && matchesTerms;
        row.hidden = !isVisible;
        tbody.appendChild(row);
        if (isVisible) shown += 1;
      }

      visibleCount.textContent = String(shown);
      emptyState.hidden = shown !== 0;
      writeUrlState(controls);
    }

    async function copyCurrentView() {
      writeUrlState(readControls());
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyStatus.textContent = 'Copied view link.';
      } catch {
        copyStatus.textContent = 'Copy failed. Use the address bar URL.';
      }
      window.setTimeout(() => {
        copyStatus.textContent = '';
      }, 2200);
    }

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    outcomeFilter.addEventListener('change', applyFilters);
    failureFilter.addEventListener('change', applyFilters);
    termsFilter.addEventListener('change', applyFilters);
    sortSelect.addEventListener('change', applyFilters);
    copyButton.addEventListener('click', copyCurrentView);
    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      statusFilter.value = '';
      outcomeFilter.value = '';
      failureFilter.value = '';
      termsFilter.value = '';
      sortSelect.value = 'name-asc';
      applyFilters();
      searchInput.focus();
    });

    restoreFromUrl();
    applyFilters();
  </script>
</BaseLayout>
